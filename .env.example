# Bags API key — get from https://bags.fm
BAGS_API_KEY=bags_prod_xxxxxxxxxxxx

# Helius RPC key — get from https://helius.dev
HELIUS_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Platform keypair for signing token launches and SPL transfers (Base58)
# Generate with: solana-keygen new --outfile platform-keypair.json
PLATFORM_PRIVATE_KEY=your_base58_private_key_here
PLATFORM_PUBLIC_KEY=your_base58_public_key_here

# Backend port (default 3001)
PORT=3001
